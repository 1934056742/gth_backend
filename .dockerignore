# ============================================================
# Docker 构建忽略清单
#
# 为什么必须有这个文件：
#   .gitignore 只影响 Git，对 docker build 完全无效。
#   如果 Dockerfile 里写了 COPY . . ，.env 会被打包进镜像层，
#   即使后面 RUN rm .env 删掉，历史层依然可以还原出明文密钥。
#   镜像一旦推到 registry，密钥就等于公开了。
# ============================================================

# 密钥与配置（最重要的一行）
.env
.env.*
!.env.example

# 依赖与产物
node_modules
dist
build

# 版本控制与文档
.git
.gitignore
*.md

# 运行期数据（上传的分片/文件不该进镜像）
uploads

# 日志与临时文件
*.log
*.out
*.tmp

# 测试产物
coverage
