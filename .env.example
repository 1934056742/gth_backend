# ============================================================
# 环境变量模板（可以安全提交到 Git）
#
# 用法：
#   1. 复制本文件为 .env      ->  cp .env.example .env
#   2. 把下面所有 xxx / change-me 换成真实值
#   3. .env 已被 .gitignore 忽略，永远不会被提交
#
# 为什么要有这个文件：
#   .env 里是真实密钥、不能提交；但没有模板，新人不知道该配哪些变量，
#   就会去问别人要 .env，或者干脆把密钥写进代码里。模板是唯一的正确入口。
# ============================================================

# ---------- 数据库 ----------
DATABASE_URL="mysql://root:你的密码@localhost:3306/task_db"

# ---------- JWT ----------
# 用于签发/校验登录 token。生产环境必须换成足够长的随机串，
# 不要用默认值，否则任何人都能伪造 token。
# 生成方法（任选其一）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ---------- AI 答疑（任意 OpenAI 兼容服务） ----------
# 密钥获取：https://platform.deepseek.com/api_keys
# 重要：请务必在控制台给这把 key 设置「额度上限」，密钥万一泄漏时损失有天花板。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 可选：从文件读取密钥（Docker / K8s 挂载 secret 时用，优先级高于上面的变量）
# DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_key

# 单次请求超时（毫秒）
AI_TIMEOUT_MS=60000
# 带进上下文的历史消息条数
AI_HISTORY_LIMIT=8
